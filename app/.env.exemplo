# Copie para `.env` e preencha. O `.env` nunca vai para o git.
# Variáveis com prefixo EXPO_PUBLIC_ vão para dentro do app (são públicas por definição):
# só a chave ANÔNIMA do Supabase entra aqui. A chave de serviço fica no servidor, nunca no app.

EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_CHAVE_ANONIMA=eyJ...

{
  "name": "academia-plus",
  "version": "0.1.0",
  "private": true,
  "description": "Aplicativo que liga uma academia aos seus alunos: duas visões (academia e aluno), treino livre e pronto, cadastro corporal opcional e o plano pago Plus.",
  "main": "expo-router/entry",
  "scripts": {
    "iniciar": "expo start",
    "iniciar:expo-go": "expo start --go",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "tipos": "tsc --noEmit",
    "testar:dominio": "node --test \"dominio/**/*.test.ts\" \"dados/**/*.test.ts\"",
    "testar:dominio:observar": "node --test --watch \"dominio/**/*.test.ts\" \"dados/**/*.test.ts\"",
    "testar:telas": "jest --passWithNoTests",
    "testar": "npm run testar:dominio && npm run testar:telas",
    "lint": "expo lint",
    "doctor": "npx expo-doctor",
    "alinhar-versoes": "npx expo install --fix",
    "build:ios:desenvolvimento": "eas build --platform ios --profile desenvolvimento",
    "build:ios:previa": "eas build --platform ios --profile previa --auto-submit",
    "build:producao": "eas build --platform all --profile producao",
    "enviar:ios": "eas submit --platform ios --profile producao",
    "gerar:tema": "node ferramentas/gerar-tema.mjs",
    "gerar:icones": "node ferramentas/gerar-icones.mjs",
    "copiar:imagens": "node ferramentas/copiar-imagens.mjs",
    "gerar": "npm run gerar:tema && npm run gerar:icones && npm run copiar:imagens",
    "exportar:web": "expo export --platform web"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.58.0",
    "@tanstack/react-query": "^5.90.0",
    "expo": "~54.0.0",
    "expo-apple-authentication": "~8.0.8",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-blur": "~15.0.7",
    "expo-constants": "~18.0.0",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-keep-awake": "~15.0.7",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.0",
    "expo-notifications": "~0.32.0",
    "expo-router": "~6.0.0",
    "expo-secure-store": "~15.0.0",
    "expo-splash-screen": "~31.0.10",
    "expo-sqlite": "~16.0.0",
    "expo-status-bar": "~3.0.0",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/react": "~19.1.10",
    "eslint": "^9.36.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.0",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/telas/**/*.test.tsx",
      "<rootDir>/componentes/**/*.test.tsx",
      "<rootDir>/navegacao/**/*.test.tsx"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|expo-router|@supabase/.*)"
    ],
    "moduleNameMapper": {
      "\\.(webp|png|jpg|jpeg|wav)$": "<rootDir>/ferramentas/jest/imagem.js"
    }
  }
}
